#!/usr/sbin/nft -f
# Generated by Parallax. Do not edit: every rule derives from the Parallax configuration.
# The table is declared, deleted and redefined in one transaction, so apply is atomic and idempotent.

table inet parallax {}
delete table inet parallax

table inet parallax {
	set ts_personal {
		type ipv4_addr
		flags interval
		comment "tailscale nodes of template personal (synced from Headscale)"
	}

	set ts_family {
		type ipv4_addr
		flags interval
		comment "tailscale nodes of template family (synced from Headscale)"
	}

	chain input {
		type filter hook input priority filter; policy accept;
		ct state established,related accept comment "established flows"
		udp dport 51820 accept comment "wireguard listen port"
		iifname { "wg0", "tailscale0" } ip daddr 10.8.0.1 udp dport 53 accept comment "dns shim"
		iifname { "wg0", "tailscale0" } ip daddr 10.8.0.1 tcp dport 53 accept comment "dns shim"
		iifname { "wg0", "tailscale0" } icmp type echo-request accept comment "ping the gateway"
		iifname { "wg0", "tailscale0" } drop comment "tunnel peers may not reach anything else on the gateway host"
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		ct state established,related accept comment "established flows"
		ct state invalid drop comment "invalid state"
		iifname "wg0" oifname "eth0" ip saddr 10.8.1.0/24 ip daddr 192.168.1.0/24 accept comment "personal/wireguard: network home"
		iifname "wg0" ip saddr 10.8.1.0/24 drop comment "personal/wireguard: default deny"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_personal ip daddr 192.168.1.0/24 accept comment "personal/tailscale: network home"
		iifname "tailscale0" ip saddr @ts_personal drop comment "personal/tailscale: default deny"
		iifname "wg0" oifname "eth0" ip saddr 10.8.2.0/24 ip daddr 192.168.1.5 tcp dport 443 accept comment "family/wireguard: service immich"
		iifname "wg0" ip saddr 10.8.2.0/24 drop comment "family/wireguard: default deny"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_family ip daddr 192.168.1.5 tcp dport 443 accept comment "family/tailscale: service immich"
		iifname "tailscale0" ip saddr @ts_family drop comment "family/tailscale: default deny"
		iifname "wg0" drop comment "wireguard: unknown source"
		iifname "tailscale0" drop comment "tailscale: unknown source"
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname { "wg0", "tailscale0" } ip daddr 192.168.240.0/24 dnat ip prefix to ip daddr map { 192.168.240.0/24 : 192.168.1.0/24 } comment "netmap home: virtual -> real"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "wg0", "tailscale0" } ip saddr 192.168.1.0/24 snat ip prefix to ip saddr map { 192.168.1.0/24 : 192.168.240.0/24 } comment "netmap home: real -> virtual (LAN-initiated)"
	}
}
