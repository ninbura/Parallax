# Generated by Parallax. Rules for Docker's DOCKER-USER chain (only when Docker runs on the gateway host).
# Apply removes previous rules commented "parallax" before inserting these, so re-applying is idempotent.
insert rule ip filter DOCKER-USER iifname "wg0" accept comment "parallax"
insert rule ip filter DOCKER-USER oifname "wg0" accept comment "parallax"
insert rule ip filter DOCKER-USER iifname "tailscale0" accept comment "parallax"
insert rule ip filter DOCKER-USER oifname "tailscale0" accept comment "parallax"
