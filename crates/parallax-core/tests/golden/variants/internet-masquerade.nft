#!/usr/sbin/nft -f
# Generated by Parallax. Do not edit: every rule derives from the Parallax configuration.
# The table is declared, deleted and redefined in one transaction, so apply is atomic and idempotent.

table inet parallax {}
delete table inet parallax

table inet parallax {
	set ts_personal {
		type ipv4_addr
		flags interval
		comment "tailscale nodes of template personal (synced from Headscale)"
	}

	set ts_family {
		type ipv4_addr
		flags interval
		comment "tailscale nodes of template family (synced from Headscale)"
	}

	set lan_real {
		type ipv4_addr
		flags interval
		comment "real prefixes of every configured network"
		elements = { 192.168.1.0/24 }
	}

	set not_public {
		type ipv4_addr
		flags interval
		comment "private, reserved and configured prefixes: not the internet"
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }
	}

	chain input {
		type filter hook input priority filter; policy accept;
		meta nfproto ipv6 iifname { "wg0", "tailscale0" } drop comment "tunnel peers are IPv4-only"
		ct direction reply accept comment "replies"
		ct state related accept comment "related (ICMP errors)"
		ct state invalid iifname { "wg0", "tailscale0" } drop comment "invalid state"
		udp dport 51820 accept comment "wireguard listen port"
		iifname { "wg0", "tailscale0" } ip daddr 10.8.0.1 udp dport 53 accept comment "dns shim"
		iifname { "wg0", "tailscale0" } ip daddr 10.8.0.1 tcp dport 53 accept comment "dns shim"
		iifname { "wg0", "tailscale0" } icmp type echo-request accept comment "ping the gateway"
		iifname { "wg0", "tailscale0" } drop comment "tunnel peers may not reach anything else on the gateway host"
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		meta nfproto ipv6 iifname { "wg0", "tailscale0" } drop comment "tunnel peers are IPv4-only"
		ct state invalid drop comment "invalid state"
		ct direction reply accept comment "replies"
		ct state related accept comment "related (ICMP errors)"
		iifname "wg0" oifname "eth0" ip saddr 10.8.1.0/24 ip daddr 192.168.1.0/24 accept comment "personal/wireguard: network home"
		iifname "wg0" oifname "eth0" ip saddr 10.8.1.0/24 ip daddr != @lan_real accept comment "personal/wireguard: internet"
		iifname "wg0" ip saddr 10.8.1.0/24 drop comment "personal/wireguard: default deny"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_personal ip daddr 192.168.1.0/24 accept comment "personal/tailscale: network home"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_personal ip daddr != @lan_real accept comment "personal/tailscale: internet"
		iifname "tailscale0" ip saddr @ts_personal drop comment "personal/tailscale: default deny"
		iifname "wg0" oifname "eth0" ip saddr 10.8.2.0/24 ip daddr 192.168.1.5 tcp dport 443 accept comment "family/wireguard: service immich"
		iifname "wg0" oifname "eth0" ip saddr 10.8.2.0/24 ip daddr != @not_public accept comment "family/wireguard: internet (public addresses)"
		iifname "wg0" ip saddr 10.8.2.0/24 drop comment "family/wireguard: default deny"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_family ip daddr 192.168.1.5 tcp dport 443 accept comment "family/tailscale: service immich"
		iifname "tailscale0" oifname "eth0" ip saddr @ts_family ip daddr != @not_public accept comment "family/tailscale: internet (public addresses)"
		iifname "tailscale0" ip saddr @ts_family drop comment "family/tailscale: default deny"
		iifname "wg0" drop comment "wireguard: unknown source"
		iifname "tailscale0" drop comment "tailscale: unknown source"
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname { "wg0", "tailscale0" } ip daddr 198.18.1.0/24 dnat ip prefix to ip daddr map { 198.18.1.0/24 : 192.168.1.0/24 } comment "netmap home: virtual -> real"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "wg0", "tailscale0" } ip saddr 192.168.1.0/24 snat ip prefix to ip saddr map { 192.168.1.0/24 : 198.18.1.0/24 } comment "netmap home: real -> virtual (LAN-initiated)"
		oifname "eth0" ip saddr { 10.8.0.0/16, 100.64.0.0/10 } ip daddr 192.168.1.0/24 masquerade comment "network home: masquerade (opt-in, hides peer identity)"
		oifname "eth0" ip saddr { 10.8.0.0/16, 100.64.0.0/10 } ip daddr != @lan_real masquerade comment "internet egress"
	}
}
