-A PARALLAX_FORWARD -i tailscale0 -m set --match-set log_denied src -m comment --comment "logged peers: blocked attempts" -m limit --limit 20/second --limit-burst 40 -j NFLOG --nflog-group 20568 --nflog-prefix "parallax denied"
