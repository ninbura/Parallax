# Generated by Parallax for iptables-restore --noflush. Do not edit.
# Apply flushes the PARALLAX_* chains, restores this file, and ensures the jumps from the built-in chains exist.
# Named sets are ipsets created by apply:
#   ipset create -exist ts_personal hash:net comment ; elements: 
#   ipset create -exist ts_family hash:net comment ; elements: 
#   ipset create -exist lan_real hash:net comment ; elements: 192.168.1.0/24
*filter
:PARALLAX_INPUT - [0:0]
:PARALLAX_FORWARD - [0:0]
-A PARALLAX_INPUT -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "established flows" -j ACCEPT
-A PARALLAX_INPUT -p udp --dport 51820 -m comment --comment "wireguard listen port" -j ACCEPT
-A PARALLAX_INPUT -i wg0 -d 10.8.0.1/32 -p udp --dport 53 -m comment --comment "dns shim" -j ACCEPT
-A PARALLAX_INPUT -i tailscale0 -d 10.8.0.1/32 -p udp --dport 53 -m comment --comment "dns shim" -j ACCEPT
-A PARALLAX_INPUT -i wg0 -d 10.8.0.1/32 -p tcp --dport 53 -m comment --comment "dns shim" -j ACCEPT
-A PARALLAX_INPUT -i tailscale0 -d 10.8.0.1/32 -p tcp --dport 53 -m comment --comment "dns shim" -j ACCEPT
-A PARALLAX_INPUT -i wg0 -p icmp --icmp-type echo-request -m comment --comment "ping the gateway" -j ACCEPT
-A PARALLAX_INPUT -i tailscale0 -p icmp --icmp-type echo-request -m comment --comment "ping the gateway" -j ACCEPT
-A PARALLAX_INPUT -i wg0 -m comment --comment "tunnel peers may not reach anything else on the gateway host" -j DROP
-A PARALLAX_INPUT -i tailscale0 -m comment --comment "tunnel peers may not reach anything else on the gateway host" -j DROP
-A PARALLAX_FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "established flows" -j ACCEPT
-A PARALLAX_FORWARD -m conntrack --ctstate INVALID -m comment --comment "invalid state" -j DROP
-A PARALLAX_FORWARD -i wg0 -o eth0 -s 10.8.1.0/24 -d 192.168.1.0/24 -m comment --comment "personal/wireguard: network home" -j ACCEPT
-A PARALLAX_FORWARD -i wg0 -o eth0 -s 10.8.1.0/24 -m set ! --match-set lan_real dst -m comment --comment "personal/wireguard: internet" -j ACCEPT
-A PARALLAX_FORWARD -i wg0 -s 10.8.1.0/24 -m comment --comment "personal/wireguard: default deny" -j DROP
-A PARALLAX_FORWARD -i tailscale0 -o eth0 -m set --match-set ts_personal src -d 192.168.1.0/24 -m comment --comment "personal/tailscale: network home" -j ACCEPT
-A PARALLAX_FORWARD -i tailscale0 -o eth0 -m set --match-set ts_personal src -m set ! --match-set lan_real dst -m comment --comment "personal/tailscale: internet" -j ACCEPT
-A PARALLAX_FORWARD -i tailscale0 -m set --match-set ts_personal src -m comment --comment "personal/tailscale: default deny" -j DROP
-A PARALLAX_FORWARD -i wg0 -o eth0 -s 10.8.2.0/24 -d 192.168.1.5/32 -p tcp --dport 443 -m comment --comment "family/wireguard: service immich" -j ACCEPT
-A PARALLAX_FORWARD -i wg0 -s 10.8.2.0/24 -m comment --comment "family/wireguard: default deny" -j DROP
-A PARALLAX_FORWARD -i tailscale0 -o eth0 -m set --match-set ts_family src -d 192.168.1.5/32 -p tcp --dport 443 -m comment --comment "family/tailscale: service immich" -j ACCEPT
-A PARALLAX_FORWARD -i tailscale0 -m set --match-set ts_family src -m comment --comment "family/tailscale: default deny" -j DROP
-A PARALLAX_FORWARD -i wg0 -m comment --comment "wireguard: unknown source" -j DROP
-A PARALLAX_FORWARD -i tailscale0 -m comment --comment "tailscale: unknown source" -j DROP
COMMIT
*nat
:PARALLAX_PREROUTING - [0:0]
:PARALLAX_POSTROUTING - [0:0]
-A PARALLAX_PREROUTING -i wg0 -d 198.18.1.0/24 -m comment --comment "netmap home: virtual -> real" -j NETMAP --to 192.168.1.0/24
-A PARALLAX_PREROUTING -i tailscale0 -d 198.18.1.0/24 -m comment --comment "netmap home: virtual -> real" -j NETMAP --to 192.168.1.0/24
-A PARALLAX_POSTROUTING -o wg0 -s 192.168.1.0/24 -m comment --comment "netmap home: real -> virtual (LAN-initiated)" -j NETMAP --to 198.18.1.0/24
-A PARALLAX_POSTROUTING -o tailscale0 -s 192.168.1.0/24 -m comment --comment "netmap home: real -> virtual (LAN-initiated)" -j NETMAP --to 198.18.1.0/24
-A PARALLAX_POSTROUTING -o eth0 -s 10.8.0.0/16 -m set ! --match-set lan_real dst -m comment --comment "internet egress" -j MASQUERADE
-A PARALLAX_POSTROUTING -o eth0 -s 100.64.0.0/10 -m set ! --match-set lan_real dst -m comment --comment "internet egress" -j MASQUERADE
