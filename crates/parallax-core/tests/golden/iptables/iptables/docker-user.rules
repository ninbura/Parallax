# Generated by Parallax. Inserted into DOCKER-USER by apply after removing rules commented "parallax".
-I DOCKER-USER 1 -m comment --comment "parallax" -j PARALLAX_FORWARD
-I DOCKER-USER 2 -i wg0 -m comment --comment "parallax" -j ACCEPT
-I DOCKER-USER 3 -o wg0 -m comment --comment "parallax" -j ACCEPT
-I DOCKER-USER 4 -i tailscale0 -m comment --comment "parallax" -j ACCEPT
-I DOCKER-USER 5 -o tailscale0 -m comment --comment "parallax" -j ACCEPT
