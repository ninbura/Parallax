# Parallax as a native service: the `parallax` user, with only the two
# capabilities it needs, and as little else of the host as works.
# docs/native.md explains each choice. tests/integration/netns.sh runs its
# daemon with this file's [Service] hardening (NETNS_DAEMON=unit), so keep
# the sandboxing lines here and nowhere else.
[Unit]
Description=Parallax gateway (WireGuard, DNS and HTTPS proxy)
Documentation=https://github.com/ninbura/Parallax/blob/main/docs/native.md
Wants=network-online.target
After=network-online.target

[Service]
# Ready once it has applied and answers on its socket, so `systemctl start`
# returns only then.
Type=notify
User=parallax
Group=parallax
# The first start fills an empty database from the TOML; after that the
# database is the configuration and the file is ignored. No file is fine
# (doctor then says there's no configuration); a bad one stops the start.
ExecStartPre=/bin/sh -c 'test ! -e /etc/parallax/parallax.toml || exec /usr/bin/parallax config import --if-empty /etc/parallax/parallax.toml'
ExecStartPre=/usr/bin/parallax doctor
ExecStartPre=/usr/bin/parallax keygen --if-missing --write-config
ExecStart=/usr/bin/parallax daemon -o /var/lib/parallax
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# /var/lib/parallax: the database, generated files, backups by default.
StateDirectory=parallax
StateDirectoryMode=0700
# /run/parallax: the CLI's socket.
RuntimeDirectory=parallax
RuntimeDirectoryMode=0700
# /etc/parallax is the service's own (tmpfiles.d): keygen writes the server
# key there, `parallax backup passphrase` the passphrase.
ReadWritePaths=/etc/parallax
UMask=0077

# CAP_NET_ADMIN: wg0, nftables, routes. CAP_NET_BIND_SERVICE: DNS on port 53.
# Ambient, so `nft`, `ip` and `wg` get them too.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Netlink drives wg0, nftables and routes; no raw or packet sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
